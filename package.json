{
  "name": "webcode",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @webcode/server --filter @webcode/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @webcode/web e2e"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
